        <name>Create Child Incident</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[var newChildInc = new GlideRecord('incident'); 
newChildInc.initialize();
newChildInc.caller_id = current.caller_id; 
newChildInc.category= current.category;
newChildInc.subcategory = current.subcategory;
newChildInc.parent_incident = current.sys_id;
newChildInc.short_description = 'Child Incident - ' + current.short_description; 
newChildInc.description = 'Child Incident + current.description';
newChildInc.cmdb_ci = current.cmdb_ci;
newChildInc.state = current.state;
newChildInc.impact = current.impact;
newChildInc.urgency = current.urgency;
newChildInc.assigned_to= current.assigned_to;
newChildInc.assignment_group = current.assignment_group;
newChildInc.insert();
action.setRedirectURL(current);
gs.addInfoMessage('Child incident created successfully.' + current.sys_id);]]></script>
