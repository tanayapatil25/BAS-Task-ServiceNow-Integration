        <script><![CDATA[var getSLAPercentage = Class.create();
getSLAPercentage.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    getPercentage: function() {
        var number = this.getParameter('sysparm_number');

        var slaPercentage = 1000;
        var gr_SLA = new GlideRecord('task_sla');
        gr_SLA.addQuery('task', number);
        gr_SLA.query();
        gs.info("abcd " + number);
        if (gr_SLA.next()) {
            slaPercentage = (gr_SLA.business_percentage);
        }
        return slaPercentage;
    },
    type: 'getSLAPercentage'
});]]></script>
