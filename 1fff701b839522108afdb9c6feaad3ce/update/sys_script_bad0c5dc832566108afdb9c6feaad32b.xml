        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var latestIncident = new GlideRecord('incident');
	latestIncident.orderByDesc('sys_created_on');
	latestIncident.query();

	if(!latestIncident.next()){
		return;
	}

	var incidentCount = new GlideRecord('incident');
	incidentCount.addQuery('cmdb_ci', current.cmdb_ci);
	incidentCount.query();

	var count = 0;
	while(incidentCount.next()){
		count++;
	}

	if(count == 5){
		var problem = new GlideRecord('problem');
		problem.initialize();
		problem.short_description = '5 incidents created on same CI: ' + current.cmdb_ci.name;
		problem.description = 'This problem ticket is created by triggering business rule for 5th incident created on same CI';
		problem.cmdb_ci = current.cmdb_ci;
		problem.insert();
	}

})(current, previous);]]></script>
