        <name>State based on country check</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) {
        return;
    }

    g_form.clearOptions('state');

    g_form.addOption('state', 'select', '-- Select State --');

    if (newValue == 'USA') {
        g_form.addOption('state', 'New York', 'New York');
        g_form.addOption('state', 'California', 'California');
        g_form.addOption('state', 'Texas', 'Texas');
    } 
    else if (newValue == 'Canada') {
        g_form.addOption('state', 'Ontario', 'Ontario');
        g_form.addOption('state', 'Quebec', 'Quebec');
    } 
    else if (newValue == 'India') {
        g_form.addOption('state', 'Maharashtra', 'Maharashtra');
        g_form.addOption('state', 'Karnataka', 'Karnataka');
    }
}]]></script>
