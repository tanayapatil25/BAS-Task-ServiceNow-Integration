        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	var closedRITMs = new GlideRecord('sc_req_item');
	closedRITMs.addQuery('state', '3');
	closedRITMs.query();
	while (closedRITMs.next()) {
		var taskGR = new GlideRecord('sc_task');
		taskGR.addQuery('request_item', closedRITMs.sys_id);
		taskGR.addQuery('state', '!=', '3');
		taskGR.query();
		while (taskGR.next()) {
			taskGR.state = '3';
			taskGR.work_notes = 'Closed because associated RITM was closed.';
			taskGR.update();
		}
	}
})(current, previous);]]></script>
