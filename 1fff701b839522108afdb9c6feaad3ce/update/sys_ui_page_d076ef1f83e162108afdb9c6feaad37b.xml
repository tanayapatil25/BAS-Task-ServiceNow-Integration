<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script/>
        <description/>
        <direct>false</direct>
        <endpoint/>
        <html><![CDATA[<html>

<head>
    <script type="text/javascript">
        function submitForm(event) {
            // event.preventDefault();
            var username = document.getElementById('username').value;
            var firstName = document.getElementById('firstName').value;
            var lastName = document.getElementById("lastName").value;
            var password = document.getElementById('password').value;
            var confirmPassword = document.getElementById('confirmPassword').value;
            var country = document.getElementById('country').value;
            if (password !== confirmPassword) {
                alert('Passwords do not match!');
                return;
            }
            var ga = new GlideAjax('UserCreationModel');
            ga.addParam("sysparm_name", 'createUser');
            ga.addParam('username', username);
            ga.addParam("firstName", firstName);
            ga.addParam("lastName", lastName);
            ga.addParam('password', password);
            ga.addParam('country', country);
            ga.getXMLAnswer(function(response) {
                window.top.location.reload();
				alert("New User Created Successfully!")
            });
        }
    </script>

</head>

<body>
    <h1>Create User</h1>
    <form onsubmit="submitForm(event); return false;">
        <table>
            <tr>
                <td>User Name:</td>
                <td><input type="text" id="username" /></td>
            </tr>
            <tr>
                <td>First Name:</td>
                <td><input type="text" id="firstName" /></td>
            </tr>
            <tr>
                <td>Last Name:</td>
                <td><input type="text" id="lastName" /></td>
            </tr>
            <tr>
                <td>Password:</td>
                <td><input type="password" id="password" /></td>
            </tr>
            <tr>
                <td>Confirm Password:</td>
                <td><input type="password" id="confirmPassword" /></td>
            </tr>
            <tr>
                <td>Country:</td>
                <td>
                    <select id="country">
                        <option value="India">India</option>
                        <option value="USA">USA</option>
                        <option value="Germany">Germany</option>
                    </select>
                </td>
            </tr>
        </table>
        <button type="submit">Submit</button>
        <button type="button" onclick="window.top.gDialogwindow.destroy()">Cancel</button>
    </form>
</body>

</html>]]></html>
