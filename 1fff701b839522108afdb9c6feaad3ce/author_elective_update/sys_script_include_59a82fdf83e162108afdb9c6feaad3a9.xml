        <access>package_private</access>
        <active>true</active>
        <api_name>global.UserCreationModel</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description/>
        <mobile_callable>false</mobile_callable>
        <name>UserCreationModel</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var UserCreationModel = Class.create();
UserCreationModel.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    CreateUserForm: function() {
        // username, firstName, lastName, password, country var username = this.getParameter('username');
        var firstName = this.getParameter('firstName');
        var lastName = this.getParameter("lastName");
        var password = this.getParameter('password');
        var country = this.getParameter('country');
        var userGR = new GlideRecord('sys_user');
        userGR.initialize();
        userGR.user_name = username;
        userGR.first_name = firstName;
        userGR.last_name = lastName;
        var userSysId = userGR.insert();
        if (usersysId) {
            var userObj = new GlideUser();
            userObj.setPassword(userSysId, password);
        }
        if (userGR.isValidField('u_country')) {
            userGR.setValue('u_country', country);
            userGR.update();
        }
        return 'User created successfully!';
    },
    type: 'UserCreationModel'
});]]></script>
