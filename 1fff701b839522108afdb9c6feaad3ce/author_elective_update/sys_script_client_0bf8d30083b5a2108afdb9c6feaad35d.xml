        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Colour the Incident</name>
        <order/>
        <script><![CDATA[function addColoredDot(color) {
    var incidentNumberField = g_form.getElement('number');
    if (incidentNumberField) {
        incidentNumberField.insertAdjacentHTML('beforebegin', "<p>Incident Type - </p><p style='color: " + color + "; font-size: 20px; margin-right: 5px;'>&#x2022; </p>");
    }
}

function addColoredDot1(color) {
    var incidentNumberField = g_form.getElement('number');
    if (incidentNumberField) {
        incidentNumberField.insertAdjacentHTML('beforebegin',
            "<p style='color:" + color + "; font-size: 20px; margin-right: 5px;' >&#x2022; < /p>");
    }
}

function onLoad() {
    //Type appropriate comment here, and begin script below
    var priority = g_form.getValue('priority').toString();
    // Apply Priority-Based Coloring 
    if (priority === "1") {
        addColoredDot('red');
    } else if (priority === "2") {
        addColoredDot('orange');
    }

    var ga = new GlideAjax('getSLAPercentage');
    ga.addParam('sysparm_name', 'getPercentage');
    ga.addParam('sys_id', g_form.getUniqueValue());
    ga.getXML(updateCampus);

}

function updateCampus(response) {
    var answer = response.responseXML.documentElement.getAttribute("answer");
    answer = Number(answer);
    if (answer >= 75) {
        addColoredDot1('red');
    } else if (answer >= 50) {
        addColoredDot1('orange');
    }
}]]></script>
